@model List<UserMessage>

@{
    ViewData["Title"] = "Mesaj";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
    int count = 0;
}

<table class="table table-borderer table-hover">
    <tr>
        <th>#</th>
        <th>Kimden</th>
        <th>Email</th>
        <th>Konu</th>
        <th>Mesaj</th>
        <th>Sil</th>
        <th>Detay</th>
    </tr>
    @foreach (var item in Model)
    {
        count++;
        <tr>
            <td>@count</td>
            <td>@item.Name</td>
            <td>@item.Email</td>
            <td>@item.Subject</td>
            <td>@(item.MessageBody.Length > 30 ? item.MessageBody.Substring(0, 30) + "..." : item.MessageBody)</td>
            <td>
                <button onclick="deleteMessage(@item.UserMessageId)" class="btn btn-outline-danger">Sil</button>
            </td>
            <td>
                <button onclick="showMessageDetail('@item.Name','@item.Email','@item.Subject','@item.MessageBody','@item.UserMessageId')"
                        class="btn btn-outline-primary">
                    Mesaj Detayı
                </button>
            </td>
        </tr>
    }
</table>

<script>
    function deleteMessage(id) {
        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bunu geri alamazsınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet Sil",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/Inbox/DeleteMessage/" + id;
            }
        });
    }

    function showMessageDetail(name, email, subject, message,id) {
        Swal.fire({
            title: 'Mesaj Detayı',
            html: `
                <p><strong>Kimden:</strong> ${name}</p>
                <p><strong>Email:</strong> ${email}</p>
                <p><strong>Konu:</strong> ${subject}</p>
                <p><strong>Mesaj:</strong><br>${message}</p>
            `,
            icon: 'info',
            confirmButtonText: 'Kapat'
        }).then((result) => {
             window.location.href = "/Inbox/ChangeToRead/" + id;
        });
    }
</script>
